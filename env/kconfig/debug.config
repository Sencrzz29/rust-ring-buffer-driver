# "debug" flavour: runtime checkers that catch the bug classes the synopsis
# talks about. Too slow for fair benchmarking, so it is a separate build.
CONFIG_LOCALVERSION="-rr-debug"

# Memory-safety bugs (out-of-bounds, use-after-free) -> "BUG: KASAN: ..."
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y

# Protocol bugs: lock-order inversions, sleeping in atomic context
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_MUTEXES=y
CONFIG_DEBUG_SPINLOCK=y

# Memory leaks (we trigger scans manually for deterministic results)
CONFIG_DEBUG_KMEMLEAK=y
CONFIG_DEBUG_KMEMLEAK_MEM_POOL_SIZE=16000
# CONFIG_DEBUG_KMEMLEAK_AUTO_SCAN is not set

# Full DWARF debug info so GDB can step through C and Rust code
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_GDB_SCRIPTS=y
