# Applied on top of `arm64 defconfig` + `mod2noconfig` for every kernel flavour.

# --- Rust for Linux ---------------------------------------------------------
CONFIG_RUST=y
# Arithmetic overflow in Rust code panics instead of wrapping silently.
# (This is what turns a naive `offset + len` into a kernel BUG — see the
# naive driver experiment.)
CONFIG_RUST_OVERFLOW_CHECKS=y
# Rust needs these off (or gendwarfksyms); defconfig already has them off,
# stated here so the requirement is explicit.
# CONFIG_MODVERSIONS is not set
# CONFIG_RANDSTRUCT_FULL is not set

# --- loadable modules (our drivers are out-of-tree .ko files) ---------------
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

# --- minimal board runtime: initramfs root, auto-populated /dev -------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEBUG_FS=y
CONFIG_PRINTK_TIME=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# CONFIG_LOCALVERSION_AUTO is not set
